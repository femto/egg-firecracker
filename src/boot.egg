// Booting a Linux vmlinux in 64-bit mode, as Firecracker does: the kernel's
// ELF segments at their physical addresses, a zero page (struct boot_params)
// with the command line and the e820 memory map, an optional initramfs at
// the top of memory, identity-mapped page tables for the first GiB, a GDT,
// and a vCPU already in long mode at the ELF entry with rsi pointing at the
// zero page.
uses alloc
const kvm = @import("kvm.egg")

// Guest physical layout, from Firecracker's arch/x86_64.
const GDT_START: u64 = 0x500
const IDT_START: u64 = 0x520
const ZERO_PAGE_START: u64 = 0x7000
const BOOT_STACK_POINTER: u64 = 0x8ff0
const PML4_START: u64 = 0x9000
const PDPTE_START: u64 = 0xa000
const PDE_START: u64 = 0xb000
const CMDLINE_START: u64 = 0x20000
const CMDLINE_MAX_SIZE = 2048
const EBDA_START: u64 = 0x9fc00
const HIMEM_START: u64 = 0x100000

const PT_LOAD: u64 = 1
const E820_RAM: u64 = 1

const PAGE_SIZE: u64 = 0x1000

const X86_CR0_PE: u64 = 0x1
const X86_CR0_PG: u64 = 0x80000000
const X86_CR4_PAE: u64 = 0x20
const EFER_LME: u64 = 0x100
const EFER_LMA: u64 = 0x400

// Where the kernel landed: its entry point, and the end of its highest
// segment, bss included.
const Kernel = struct {
    entry: u64
    end: u64
}

// Loads the PT_LOAD segments of the ELF64 x86_64 image at their physical
// addresses.
fn load_elf(mem: kvm.GuestMemory, image: []u8) !Kernel {
    if (@len(image) < 64 or image[0] != 0x7f or image[1] != 'E' or image[2] != 'L' or image[3] != 'F') {
        return error.NotElf
    }
    // ELFCLASS64, little-endian, EM_X86_64
    if (image[4] != 2 or image[5] != 1 or kvm.le(image, 0x12, 2) != 0x3e) {
        return error.NotX86_64Elf
    }
    const entry = kvm.le(image, 0x18, 8)
    const phoff = kvm.le(image, 0x20, 8)
    const phentsize = @as(i64, kvm.le(image, 0x36, 2))
    const phnum = @as(i64, kvm.le(image, 0x38, 2))
    const len = @as(u64, @len(image))
    if (phentsize < 56 or phoff > len or @as(u64, phnum * phentsize) > len - phoff) {
        return error.BadElf
    }
    var end: u64 = 0
    var i = 0
    while (i < phnum) {
        const ph = @as(i64, phoff) + i * phentsize
        if (kvm.le(image, ph, 4) == PT_LOAD) {
            const offset = kvm.le(image, ph + 8, 8)
            const paddr = kvm.le(image, ph + 0x18, 8)
            const filesz = kvm.le(image, ph + 0x20, 8)
            const memsz = kvm.le(image, ph + 0x28, 8)
            if (offset > len or filesz > len - offset or filesz > memsz or memsz > @as(u64, mem.size) or paddr > @as(u64, mem.size) - memsz) {
                return error.BadElf
            }
            if (paddr + memsz > end) {
                end = paddr + memsz
            }
            // The rest of memsz is bss, already zero in fresh guest memory.
            const start = @as(i64, offset)
            try mem.write(paddr, image[start..start + @as(i64, filesz)])
        }
        i = i + 1
    }
    return Kernel{ .entry = entry, .end = end }
}

// Copies the initramfs to the top of guest memory, page aligned, as
// Firecracker does, and returns its address. It must not reach down into
// the kernel.
fn load_initrd(mem: kvm.GuestMemory, kernel: Kernel, image: []u8) !u64 {
    const len = @as(u64, @len(image))
    const top = @as(u64, mem.size)
    if (len > top or top - len < kernel.end) {
        return error.InitrdTooBig
    }
    const addr = (top - len) / PAGE_SIZE * PAGE_SIZE
    if (addr < kernel.end) {
        return error.InitrdTooBig
    }
    try mem.write(addr, image)
    return addr
}

// The zero page, the command line, the page tables and the GDT. An
// initrd_size of 0 means no initramfs.
fn write_boot_data(mem: kvm.GuestMemory, a: Allocator, cmdline: str, initrd_addr: u64, initrd_size: u64) !void {
    if (@len(cmdline) >= CMDLINE_MAX_SIZE) {
        return error.CmdlineTooLong
    }
    const line = a.concat(cmdline, "\x00")
    defer a.free(line)
    try mem.write(CMDLINE_START, line[0..])

    // struct boot_params
    var zp = a.alloc(4096, @as(u8, 0))
    defer a.free(zp)
    kvm.put_le(&zp[0..], 0x1fe, 2, 0xaa55)          // hdr.boot_flag
    kvm.put_le(&zp[0..], 0x202, 4, 0x53726448)      // hdr.header: "HdrS"
    kvm.put_le(&zp[0..], 0x210, 1, 0xff)            // hdr.type_of_loader: undefined
    kvm.put_le(&zp[0..], 0x228, 4, CMDLINE_START)   // hdr.cmd_line_ptr
    kvm.put_le(&zp[0..], 0x230, 4, 0x1000000)       // hdr.kernel_alignment
    kvm.put_le(&zp[0..], 0x238, 4, @as(u64, @len(cmdline)))  // hdr.cmdline_size
    if (initrd_size > 0) {
        kvm.put_le(&zp[0..], 0x218, 4, initrd_addr)     // hdr.ramdisk_image
        kvm.put_le(&zp[0..], 0x21c, 4, initrd_size)     // hdr.ramdisk_size
    }
    // e820: low memory below the EBDA, and everything from 1 MiB.
    kvm.put_le(&zp[0..], 0x1e8, 1, 2)               // e820_entries
    put_e820(&zp[0..], 0, 0, EBDA_START)
    put_e820(&zp[0..], 1, HIMEM_START, @as(u64, mem.size) - HIMEM_START)
    try mem.write(ZERO_PAGE_START, zp[0..])

    // Identity map of the first GiB in 2 MiB pages: PML4[0] -> PDPT,
    // PDPT[0] -> PD, PD[i] -> i * 2 MiB (present, writable, huge).
    var page = a.alloc(4096, @as(u8, 0))
    defer a.free(page)
    kvm.put_le(&page[0..], 0, 8, PDPTE_START | 0x03)
    try mem.write(PML4_START, page[0..])
    kvm.put_le(&page[0..], 0, 8, PDE_START | 0x03)
    try mem.write(PDPTE_START, page[0..])
    var i = 0
    while (i < 512) {
        kvm.put_le(&page[0..], i * 8, 8, (@as(u64, i) << 21) | 0x83)
        i = i + 1
    }
    try mem.write(PDE_START, page[0..])

    // GDT: null, 64-bit code (0x08), data (0x10), TSS (0x18); a null IDT.
    var gdt = a.alloc(40, @as(u8, 0))
    defer a.free(gdt)
    kvm.put_le(&gdt[0..], 8, 8, gdt_entry(0xa09b, 0, 0xfffff))
    kvm.put_le(&gdt[0..], 16, 8, gdt_entry(0xc093, 0, 0xfffff))
    kvm.put_le(&gdt[0..], 24, 8, gdt_entry(0x808b, 0, 0xfffff))
    try mem.write(GDT_START, gdt[0..])
}

fn put_e820(inout zp: []u8, n: i64, addr: u64, size: u64) void {
    const off = 0x2d0 + n * 20
    kvm.put_le(&zp[0..], off, 8, addr)
    kvm.put_le(&zp[0..], off + 8, 8, size)
    kvm.put_le(&zp[0..], off + 16, 4, E820_RAM)
}

fn gdt_entry(flags: u64, base: u64, limit: u64) u64 {
    return ((base & 0xff000000) << 32) | ((flags & 0xf0ff) << 40) | ((limit & 0xf0000) << 32) | ((base & 0xffffff) << 16) | (limit & 0xffff)
}

// The segments, descriptor tables and control registers for long mode.
fn configure_sregs(inout s: []u8) void {
    // code: type 0xb (execute/read, accessed), S, long mode
    put_segment(&s[0..], kvm.SREG_CS, 0x08, 0x0b, 1, 0, 1)
    // data: type 3 (read/write, accessed), S, 32-bit default size
    put_segment(&s[0..], kvm.SREG_DS, 0x10, 0x03, 1, 1, 0)
    put_segment(&s[0..], kvm.SREG_ES, 0x10, 0x03, 1, 1, 0)
    put_segment(&s[0..], kvm.SREG_FS, 0x10, 0x03, 1, 1, 0)
    put_segment(&s[0..], kvm.SREG_GS, 0x10, 0x03, 1, 1, 0)
    put_segment(&s[0..], kvm.SREG_SS, 0x10, 0x03, 1, 1, 0)
    // TSS: type 0xb (busy 64-bit TSS), a system segment
    put_segment(&s[0..], kvm.SREG_TR, 0x18, 0x0b, 0, 0, 0)

    // kvm_dtable: base (u64), limit (u16)
    kvm.put_le(&s[0..], kvm.SREG_GDT, 8, GDT_START)
    kvm.put_le(&s[0..], kvm.SREG_GDT + 8, 2, 4 * 8 - 1)
    kvm.put_le(&s[0..], kvm.SREG_IDT, 8, IDT_START)
    kvm.put_le(&s[0..], kvm.SREG_IDT + 8, 2, 8 - 1)

    kvm.put_le(&s[0..], kvm.SREG_CR3, 8, PML4_START)
    const cr4 = kvm.le(s, kvm.SREG_CR4, 8) | X86_CR4_PAE
    const cr0 = kvm.le(s, kvm.SREG_CR0, 8) | X86_CR0_PE | X86_CR0_PG
    const efer = kvm.le(s, kvm.SREG_EFER, 8) | EFER_LME | EFER_LMA
    kvm.put_le(&s[0..], kvm.SREG_CR4, 8, cr4)
    kvm.put_le(&s[0..], kvm.SREG_CR0, 8, cr0)
    kvm.put_le(&s[0..], kvm.SREG_EFER, 8, efer)
}

// struct kvm_segment: base, limit, selector, type, present, dpl, db, s, l,
// g, avl, unusable. Flat: base 0, 4 GiB limit in 4 KiB pages, present.
fn put_segment(inout s: []u8, off: i64, selector: u64, kind: u64, code_or_data: u64, db: u64, l: u64) void {
    kvm.put_le(&s[0..], off, 8, 0)
    kvm.put_le(&s[0..], off + 8, 4, 0xffffffff)
    kvm.put_le(&s[0..], off + 12, 2, selector)
    kvm.put_le(&s[0..], off + 14, 1, kind)
    kvm.put_le(&s[0..], off + 15, 1, 1)             // present
    kvm.put_le(&s[0..], off + 16, 1, 0)             // dpl
    kvm.put_le(&s[0..], off + 17, 1, db)
    kvm.put_le(&s[0..], off + 18, 1, code_or_data)  // s
    kvm.put_le(&s[0..], off + 19, 1, l)
    kvm.put_le(&s[0..], off + 20, 1, 1)             // g
    kvm.put_le(&s[0..], off + 21, 1, 0)             // avl
    kvm.put_le(&s[0..], off + 22, 1, 0)             // unusable
}

// rip at the kernel's entry, rsi at the zero page, a stack below the page
// tables.
fn configure_regs(inout r: []u8, entry: u64) void {
    kvm.put_le(&r[0..], kvm.RFLAGS * 8, 8, 0x2)
    kvm.put_le(&r[0..], kvm.RIP * 8, 8, entry)
    kvm.put_le(&r[0..], kvm.RSP * 8, 8, BOOT_STACK_POINTER)
    kvm.put_le(&r[0..], kvm.RBP * 8, 8, BOOT_STACK_POINTER)
    kvm.put_le(&r[0..], kvm.RSI * 8, 8, ZERO_PAGE_START)
}
