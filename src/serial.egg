// An 8250 UART at 0x3f8 (ttyS0). The kernel's console prints by polling
// it; the tty driver, which carries what user space writes, sends a byte
// each time the transmitter-empty (THRE) interrupt arrives on IRQ 4. A byte
// written is sent at once, so the transmitter is always empty. Bytes
// received wait in a FIFO, with the received-data interrupt raised while
// there are any.

const BASE = 0x3f8
const PORTS = 8

// Register offsets from BASE.
const DATA = 0      // THR on write, RBR on read; divisor low with DLAB
const IER = 1       // interrupt enable; divisor high with DLAB
const IIR = 2       // interrupt identification on read, FCR on write
const LCR = 3
const MCR = 4
const LSR = 5
const MSR = 6
const SCR = 7

const IRQ: u64 = 4

const IER_RDA: u8 = 0x01
const IER_THRE: u8 = 0x02
const LCR_DLAB: u8 = 0x80
const MCR_OUT2: u8 = 0x08        // gates the IRQ on PC UARTs
const MCR_LOOP: u8 = 0x10
const LSR_DATA_READY: u8 = 0x01
const LSR_THR_EMPTY: u8 = 0x60   // THRE and TEMT: ready to send
const IIR_NONE: u8 = 0x01
const IIR_THRE: u8 = 0x02
const IIR_RDA: u8 = 0x04
const MSR_IDLE: u8 = 0xb0        // DCD, DSR and CTS

// The receive FIFO's size: a byte array's length must be a literal, so
// Serial.rx spells it out.
const FIFO_SIZE = 64

const Serial = struct {
    ier: u8
    lcr: u8
    mcr: u8
    scr: u8
    dll: u8
    dlh: u8
    // The THRE interrupt is pending: IIR reports it until it is read.
    thre: bool
    // An edge to send on IRQ, taken by the VMM after the access.
    raise: bool
    // Received bytes, rx_len of them from rx_head, waiting to be read.
    rx: [64]u8
    rx_head: i64
    rx_len: i64

    fn init() Serial {
        return Serial{ .ier = 0, .lcr = 0x03, .mcr = 0x08, .scr = 0, .dll = 0x0c, .dlh = 0, .thre = false, .raise = false, .rx = @splat(0), .rx_head = 0, .rx_len = 0 }
    }

    // Room in the receive FIFO for input. Input waits outside until the
    // guest reads RBR, IIR or LSR with the received-data interrupt enabled:
    // the 8250 driver reads and drops what is in RBR as it opens the port,
    // and its probe enables every interrupt for a moment.
    fn rx_room(self: Serial) i64 {
        if (self.ier & IER_RDA == 0) {
            return 0
        }
        return FIFO_SIZE - self.rx_len
    }

    // Whether a read of port may take input: RBR, IIR or LSR.
    fn reads_rx(self: Serial, port: i64) bool {
        const off = port - BASE
        return (off == DATA and self.lcr & LCR_DLAB == 0) or off == IIR or off == LSR
    }

    // A byte from the outside; false when the FIFO is full and it is not
    // taken.
    fn receive(inout self: Serial, v: u8) bool {
        if (self.rx_len == FIFO_SIZE) {
            return false
        }
        self.rx[(self.rx_head + self.rx_len) % FIFO_SIZE] = v
        self.rx_len = self.rx_len + 1
        self.data_ready()
        return true
    }

    fn data_ready(inout self: Serial) void {
        if (self.ier & IER_RDA != 0) {
            self.raise = self.mcr & MCR_OUT2 != 0
        }
    }

    fn owns(port: i64) bool {
        return port >= BASE and port < BASE + PORTS
    }

    // A write to port; the byte sent, or -1 for a write to a register.
    fn write(inout self: Serial, port: i64, v: u8) i64 {
        const off = port - BASE
        const dlab = self.lcr & LCR_DLAB != 0
        if (off == DATA) {
            if (dlab) {
                self.dll = v
            } else {
                // Sent (or, in loopback, dropped): the transmitter is
                // empty again.
                self.thr_empty()
                if (self.mcr & MCR_LOOP == 0) {
                    return @as(i64, v)
                }
            }
        } else if (off == IER) {
            if (dlab) {
                self.dlh = v
            } else {
                const was = self.ier & IER_THRE != 0
                const was_rda = self.ier & IER_RDA != 0
                self.ier = v & 0x0f
                if (!was_rda and self.ier & IER_RDA != 0) {
                    // Input may be waiting outside the FIFO: an edge, and
                    // the handler's read of IIR brings it in.
                    self.data_ready()
                }
                if (self.ier & IER_THRE == 0) {
                    self.thre = false
                    self.raise = self.raise and self.rx_len > 0 and self.ier & IER_RDA != 0
                } else if (!was) {
                    // Enabling it with the transmitter empty raises it.
                    self.thr_empty()
                }
            }
        } else if (off == LCR) {
            self.lcr = v
        } else if (off == MCR) {
            const was_open = self.mcr & MCR_OUT2 != 0
            self.mcr = v & 0x1f
            if (!was_open and self.mcr & MCR_OUT2 != 0 and self.pending()) {
                // Opening the gate on a pending interrupt raises the line.
                self.raise = true
            }
        } else if (off == SCR) {
            self.scr = v
        }
        return -1
    }

    // An enabled interrupt is waiting for IIR to report it.
    fn pending(self: Serial) bool {
        return self.thre or (self.ier & IER_RDA != 0 and self.rx_len > 0)
    }

    fn thr_empty(inout self: Serial) void {
        if (self.ier & IER_THRE != 0) {
            self.thre = true
            self.raise = self.mcr & MCR_OUT2 != 0
        }
    }

    // Whether to send an edge on IRQ now; clears it.
    fn take_irq(inout self: Serial) bool {
        const r = self.raise
        self.raise = false
        return r
    }

    fn read(inout self: Serial, port: i64) u8 {
        const off = port - BASE
        const dlab = self.lcr & LCR_DLAB != 0
        if (off == DATA) {
            if (dlab) {
                return self.dll
            }
            if (self.rx_len == 0) {
                return 0
            }
            const v = self.rx[self.rx_head]
            self.rx_head = (self.rx_head + 1) % FIFO_SIZE
            self.rx_len = self.rx_len - 1
            return v
        } else if (off == IER) {
            if (dlab) {
                return self.dlh
            }
            return self.ier
        } else if (off == IIR) {
            // Received data comes first, until it is read. Reading IIR
            // when it reports THRE clears it.
            if (self.ier & IER_RDA != 0 and self.rx_len > 0) {
                return IIR_RDA
            }
            if (self.thre) {
                self.thre = false
                return IIR_THRE
            }
            return IIR_NONE
        } else if (off == LCR) {
            return self.lcr
        } else if (off == MCR) {
            return self.mcr
        } else if (off == LSR) {
            if (self.rx_len > 0) {
                return LSR_THR_EMPTY | LSR_DATA_READY
            }
            return LSR_THR_EMPTY
        } else if (off == MSR) {
            if (self.mcr & MCR_LOOP != 0) {
                // Loopback, which the kernel's probe checks: DTR to DSR,
                // RTS to CTS, OUT1 to RI, OUT2 to DCD.
                const m = self.mcr
                return ((m & 0x01) << 5) | ((m & 0x02) << 3) | ((m & 0x04) << 4) | ((m & 0x08) << 4)
            }
            return MSR_IDLE
        }
        return self.scr
    }
}
