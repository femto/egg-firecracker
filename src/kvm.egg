// KVM through /dev/kvm (x86_64 Linux), and the terminal. This is the only
// unsafe file: the rest of the VMM reaches guest memory and kvm_run through
// the bounds-checked methods below.
//
// Egg has no C struct layout yet, so the KVM structs are byte buffers with
// fields at their offsets from <linux/kvm.h>, and struct termios one with
// glibc's x86_64 offsets.
uses fs, alloc, io
allow unsafe

extern fn open(path: *u8, flags: i32) i32 uses fs
extern fn close(fd: i32) i32 uses fs
// ioctl is variadic in C; every KVM request here passes one integer or
// pointer argument, which the x86_64 calling convention passes the same way.
extern fn ioctl(fd: i32, req: u64, arg: u64) i32 uses fs
extern fn mmap(addr: *u8, len: usize, prot: i32, flags: i32, fd: i32, off: i64) *u8 uses alloc
extern fn lseek(fd: i32, off: i64, whence: i32) i64 uses fs
extern fn munmap(addr: *u8, len: usize) i32 uses alloc
// Io reads its standard input a line at a time; a guest's console wants
// each byte as it is typed, with the terminal in raw mode.
extern fn read(fd: i32, buf: *u8, n: usize) i64 uses io
extern fn write(fd: i32, buf: *u8, n: usize) i64 uses io
extern fn isatty(fd: i32) i32 uses io
extern fn tcgetattr(fd: i32, t: *u8) i32 uses io
extern fn tcsetattr(fd: i32, when: i32, t: *u8) i32 uses io
extern fn _exit(code: i32) void uses io
// A disk image, read and written straight between the file and guest
// memory.
extern fn pread(fd: i32, buf: *u8, n: usize, off: i64) i64 uses fs
extern fn pwrite(fd: i32, buf: *u8, n: usize, off: i64) i64 uses fs
extern fn fsync(fd: i32) i32 uses fs
extern fn flock(fd: i32, op: i32) i32 uses fs
// For a temporary disk: mkstemp is in <stdlib.h>, which Egg's C includes,
// with a char * that a *u8 here would clash with.
extern fn creat(path: *u8, mode: u32) i32 uses fs
extern fn getpid() i32 uses fs
extern fn unlink(path: *u8) i32 uses fs
extern fn ftruncate(fd: i32, len: i64) i32 uses fs

const O_RDWR: i32 = 2
const LOCK_EX: i32 = 2
const LOCK_NB: i32 = 4
const O_CLOEXEC: i32 = 0x80000
const PROT_RW: i32 = 3
const MAP_SHARED: i32 = 0x01
const MAP_PRIVATE: i32 = 0x02
const MAP_ANONYMOUS: i32 = 0x20
const MAP_NORESERVE: i32 = 0x4000
const MAP_FAILED: usize = 18446744073709551615
const SEEK_END_: i32 = 2
const PROT_READ: i32 = 1

// struct termios: c_iflag, c_oflag, c_cflag, c_lflag (u32 each), c_line,
// c_cc[32], then the speeds.
const TERMIOS_SIZE = 60
const C_IFLAG = 0
const C_LFLAG = 12
const C_CC_VTIME = 17 + 5
const C_CC_VMIN = 17 + 6
// What cfmakeraw clears, but OPOST: input untranslated, no echo, no
// signals.
const IGNBRK: u64 = 0x1
const BRKINT: u64 = 0x2
const PARMRK: u64 = 0x8
const ISTRIP: u64 = 0x20
const INLCR: u64 = 0x40
const IGNCR: u64 = 0x80
const ICRNL: u64 = 0x100
const IXON: u64 = 0x400
const ISIG: u64 = 0x1
const ICANON: u64 = 0x2
const ECHO: u64 = 0x8
const ECHONL: u64 = 0x40
const IEXTEN: u64 = 0x8000
const TCSANOW: i32 = 0

// ioctl numbers: _IO(0xAE, n), or _IOR/_IOW/_IOWR with the struct's size.
const KVM_GET_API_VERSION: u64 = 0xAE00
const KVM_CREATE_VM: u64 = 0xAE01
const KVM_GET_VCPU_MMAP_SIZE: u64 = 0xAE04
const KVM_GET_SUPPORTED_CPUID: u64 = 0xC008AE05
const KVM_CREATE_VCPU: u64 = 0xAE41
const KVM_SET_USER_MEMORY_REGION: u64 = 0x4020AE46
const KVM_SET_TSS_ADDR: u64 = 0xAE47
const KVM_CREATE_IRQCHIP: u64 = 0xAE60
const KVM_IRQ_LINE: u64 = 0x4008AE61
const KVM_CREATE_PIT2: u64 = 0x4040AE77
const KVM_RUN: u64 = 0xAE80
const KVM_GET_REGS: u64 = 0x8090AE81
const KVM_SET_REGS: u64 = 0x4090AE82
const KVM_GET_SREGS: u64 = 0x8138AE83
const KVM_SET_SREGS: u64 = 0x4138AE84
const KVM_SET_FPU: u64 = 0x41A0AE8D
const KVM_GET_LAPIC: u64 = 0x8400AE8E
const KVM_SET_LAPIC: u64 = 0x4400AE8F
const KVM_SET_CPUID2: u64 = 0x4008AE90

const KVM_API_VERSION: i32 = 12
const REGS_SIZE = 144       // struct kvm_regs: 18 u64
const SREGS_SIZE = 312      // struct kvm_sregs
const FPU_SIZE = 416        // struct kvm_fpu
const LAPIC_SIZE = 1024     // struct kvm_lapic_state
const CPUID_ENTRY_SIZE = 40 // struct kvm_cpuid_entry2
const CPUID_MAX_ENTRIES = 256

// Where KVM puts the three pages of the TSS Intel needs, below 4 GiB and
// out of guest RAM; Firecracker's address.
const TSS_ADDR: u64 = 0xfffbd000

// kvm_run->exit_reason
const EXIT_IO = 2
const EXIT_HLT = 5
const EXIT_MMIO = 6
const EXIT_SHUTDOWN = 8
const EXIT_FAIL_ENTRY = 9
const EXIT_INTERNAL_ERROR = 17
const EXIT_SYSTEM_EVENT = 24

// kvm_regs, as indexes of u64
const RAX = 0
const RBX = 1
const RSI = 4
const RSP = 6
const RBP = 7
const RIP = 16
const RFLAGS = 17

// kvm_sregs: eight kvm_segments of 24 bytes (cs, ds, es, fs, gs, ss, tr,
// ldt), two kvm_dtables of 16 (gdt, idt), then the control registers.
const SREG_CS = 0
const SREG_DS = 24
const SREG_ES = 48
const SREG_FS = 72
const SREG_GS = 96
const SREG_SS = 120
const SREG_TR = 144
const SREG_GDT = 192
const SREG_IDT = 208
const SREG_CR0 = 224
const SREG_CR3 = 240
const SREG_CR4 = 248
const SREG_EFER = 264

fn le(b: []u8, off: i64, n: i64) u64 {
    var v: u64 = 0
    var i = n - 1
    while (i >= 0) {
        v = (v << 8) | @as(u64, b[off + i])
        i = i - 1
    }
    return v
}

fn put_le(inout b: []u8, off: i64, n: i64, v: u64) void {
    var x = v
    var i = 0
    while (i < n) {
        b[off + i] = @as(u8, x & 0xff)
        x = x >> 8
        i = i + 1
    }
}

fn sys(r: i32) !i32 {
    if (r < 0) {
        return error.KvmFailed
    }
    return r
}

fn map(len: i64, prot: i32, flags: i32, fd: i32) !*u8 {
    const p = mmap(null, @as(usize, len), prot, flags, fd, 0)
    if (@intFromPtr(p) == MAP_FAILED) {
        return error.MmapFailed
    }
    return p
}

fn ioctl_buf(fd: i32, req: u64, b: Buf(u8)) !i32 {
    return sys(ioctl(fd, req, @as(u64, @intFromPtr(@bufPtr(b)))))
}

fn close_fd(fd: i32) void {
    _ = close(fd)
}

fn unmap(p: *u8, len: i64) void {
    _ = munmap(p, @as(usize, len))
}

// Puts standard input, when it is a terminal, in raw mode: every byte as it
// is typed, unechoed, with ^C and ^Z bytes like the rest, for the guest.
// Output keeps its processing, so a newline still starts a line. Gives the
// settings to restore, empty when standard input is not a terminal.
fn raw_stdin(a: Allocator) !Buf(u8) {
    var saved = a.alloc(TERMIOS_SIZE, @as(u8, 0))
    errdefer a.free(saved)
    if (isatty(0) == 0) {
        a.resize(&saved, 0, 0)
        return saved
    }
    _ = try sys(tcgetattr(0, @bufPtr(saved)))
    var t = a.alloc(TERMIOS_SIZE, @as(u8, 0))
    defer a.free(t)
    _ = try sys(tcgetattr(0, @bufPtr(t)))
    const iflag = le(t, C_IFLAG, 4) & ~(IGNBRK | BRKINT | PARMRK | ISTRIP | INLCR | IGNCR | ICRNL | IXON)
    const lflag = le(t, C_LFLAG, 4) & ~(ISIG | ICANON | ECHO | ECHONL | IEXTEN)
    put_le(&t[0..], C_IFLAG, 4, iflag)
    put_le(&t[0..], C_LFLAG, 4, lflag)
    t[C_CC_VTIME] = 0
    t[C_CC_VMIN] = 1
    _ = try sys(tcsetattr(0, TCSANOW, @bufPtr(t)))
    return saved
}

fn restore_stdin(saved: Buf(u8)) void {
    if (@len(saved) == TERMIOS_SIZE) {
        _ = tcsetattr(0, TCSANOW, @bufPtr(saved))
    }
}

// Up to @len(b) bytes of standard input into b; 0 at its end, negative on
// an error.
fn read_stdin(b: Buf(u8)) i64 {
    return read(0, @bufPtr(b), @as(usize, @len(b)))
}

// All of b to standard output, as it is: no line added.
fn write_stdout(b: Buf(u8)) void {
    var done = 0
    while (done < @len(b)) {
        const n = write(1, @ptrAdd(@bufPtr(b), done), @as(usize, @len(b) - done))
        if (n <= 0) {
            return
        }
        done = done + n
    }
}

// Ends the process at once, with every thread.
fn exit_now(code: i32) void {
    _exit(code)
}

// A disk image open for reading and writing, of size bytes.
const Disk = struct {
    fd: i32
    size: u64

    // Locked for this process alone: two guests writing one file system
    // image would corrupt it.
    fn open_path(a: Allocator, path: str) !Disk {
        const fd = try sys(open(a.cstr(path), O_RDWR | O_CLOEXEC))
        errdefer close_fd(fd)
        if (flock(fd, LOCK_EX | LOCK_NB) < 0) {
            return error.DiskInUse
        }
        const size = lseek(fd, 0, SEEK_END_)
        if (size < 0) {
            return error.DiskFailed
        }
        return Disk{ .fd = fd, .size = @as(u64, size) }
    }

    // A disk of size bytes, all zero, in a temporary file already
    // unlinked: for tests.
    fn temp(a: Allocator, size: i64) !Disk {
        var name = a.concat("/tmp/egg-firecracker-disk-", "")
        a.append_int(&name, getpid())
        const path = a.cstr(a.leak(name))
        a.free(name)
        close_fd(try sys(creat(path, 0x180)))   // 0600
        const fd = try sys(open(path, O_RDWR | O_CLOEXEC))
        _ = unlink(path)
        errdefer close_fd(fd)
        _ = try sys(ftruncate(fd, size))
        return Disk{ .fd = fd, .size = @as(u64, size) }
    }

    fn close(self: Disk) void {
        close_fd(self.fd)
    }

    // len bytes of the disk from off into guest memory at addr.
    fn read_into(self: Disk, mem: GuestMemory, addr: u64, len: i64, off: u64) !void {
        const start = mem.offset(addr, len)
        if (start < 0) {
            return error.OutOfGuestMemory
        }
        if (off > self.size or @as(u64, len) > self.size - off) {
            return error.OutOfDisk
        }
        var done = 0
        while (done < len) {
            const n = pread(self.fd, @ptrAdd(mem.base, start + done), @as(usize, len - done), @as(i64, off) + done)
            if (n <= 0) {
                return error.DiskFailed
            }
            done = done + n
        }
    }

    // len bytes of guest memory at addr onto the disk from off.
    fn write_from(self: Disk, mem: GuestMemory, addr: u64, len: i64, off: u64) !void {
        const start = mem.offset(addr, len)
        if (start < 0) {
            return error.OutOfGuestMemory
        }
        if (off > self.size or @as(u64, len) > self.size - off) {
            return error.OutOfDisk
        }
        var done = 0
        while (done < len) {
            const n = pwrite(self.fd, @ptrAdd(mem.base, start + done), @as(usize, len - done), @as(i64, off) + done)
            if (n <= 0) {
                return error.DiskFailed
            }
            done = done + n
        }
    }

    fn sync(self: Disk) !void {
        _ = try sys(fsync(self.fd))
    }
}

// The whole file at path. Through open and mmap rather than the fs
// capability: using that makes the generated C include <fcntl.h>, whose
// open (variadic, const char *) clashes with the extern fn above.
fn read_file(a: Allocator, path: str) !Buf(u8) {
    const fd = try sys(open(a.cstr(path), O_CLOEXEC))   // O_RDONLY
    defer close_fd(fd)
    const size = lseek(fd, 0, SEEK_END_)
    if (size <= 0) {
        return error.EmptyFile
    }
    const p = try map(size, PROT_READ, MAP_PRIVATE, fd)
    defer unmap(p, size)
    var b = a.alloc(size, @as(u8, 0))
    var i = 0
    while (i < size) {
        b[i] = @ptrAdd(p, i).*
        i = i + 1
    }
    return b
}

const Kvm = struct {
    fd: i32

    fn init(a: Allocator) !Kvm {
        const fd = try sys(open(a.cstr("/dev/kvm"), O_RDWR | O_CLOEXEC))
        const kvm = Kvm{ .fd = fd }
        if (try sys(ioctl(fd, KVM_GET_API_VERSION, 0)) != KVM_API_VERSION) {
            return error.KvmApiVersion
        }
        return kvm
    }

    fn create_vm(self: Kvm) !Vm {
        const fd = try sys(ioctl(self.fd, KVM_CREATE_VM, 0))
        return Vm{ .fd = fd, .kvm = self.fd }
    }

    // struct kvm_cpuid2: nent, padding, then nent kvm_cpuid_entry2.
    fn supported_cpuid(self: Kvm, a: Allocator) !Buf(u8) {
        var b = a.alloc(8 + CPUID_MAX_ENTRIES * CPUID_ENTRY_SIZE, @as(u8, 0))
        errdefer a.free(b)
        put_le(&b[0..], 0, 4, @as(u64, CPUID_MAX_ENTRIES))
        _ = try ioctl_buf(self.fd, KVM_GET_SUPPORTED_CPUID, b)
        return b
    }
}

const Vm = struct {
    fd: i32
    kvm: i32

    // The interrupt controllers (PIC, IOAPIC, a local APIC per vCPU) and
    // the PIT live in KVM, as in Firecracker.
    fn create_irqchip(self: Vm, a: Allocator) !void {
        _ = try sys(ioctl(self.fd, KVM_SET_TSS_ADDR, TSS_ADDR))
        _ = try sys(ioctl(self.fd, KVM_CREATE_IRQCHIP, 0))
        // struct kvm_pit_config: flags, then padding; KVM_PIT_SPEAKER_DUMMY.
        var pit = a.alloc(64, @as(u8, 0))
        defer a.free(pit)
        put_le(&pit[0..], 0, 4, 1)
        _ = try ioctl_buf(self.fd, KVM_CREATE_PIT2, pit)
    }

    // Sets an interrupt line of the in-kernel PIC and IOAPIC high or low.
    fn irq_line(self: Vm, a: Allocator, irq: u64, level: u64) !void {
        // struct kvm_irq_level: irq, level
        var b = a.alloc(8, @as(u8, 0))
        defer a.free(b)
        put_le(&b[0..], 0, 4, irq)
        put_le(&b[0..], 4, 4, level)
        _ = try ioctl_buf(self.fd, KVM_IRQ_LINE, b)
    }

    // An edge on an ISA interrupt line, as the UART's IRQ is.
    fn irq_pulse(self: Vm, a: Allocator, irq: u64) !void {
        try self.irq_line(a, irq, 1)
        try self.irq_line(a, irq, 0)
    }

    // Anonymous memory of size bytes, seen by the guest at gpa.
    fn add_memory(self: Vm, a: Allocator, slot: u32, gpa: u64, size: i64) !GuestMemory {
        const p = try map(size, PROT_RW, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1)
        // struct kvm_userspace_memory_region: slot, flags, gpa, size, host address
        var region = a.alloc(32, @as(u8, 0))
        defer a.free(region)
        put_le(&region[0..], 0, 4, @as(u64, slot))
        put_le(&region[0..], 8, 8, gpa)
        put_le(&region[0..], 16, 8, @as(u64, size))
        put_le(&region[0..], 24, 8, @as(u64, @intFromPtr(p)))
        _ = try ioctl_buf(self.fd, KVM_SET_USER_MEMORY_REGION, region)
        return GuestMemory{ .base = p, .gpa = gpa, .size = size }
    }

    fn create_vcpu(self: Vm, id: u64) !Vcpu {
        const fd = try sys(ioctl(self.fd, KVM_CREATE_VCPU, id))
        const size = try sys(ioctl(self.kvm, KVM_GET_VCPU_MMAP_SIZE, 0))
        const run = try map(@as(i64, size), PROT_RW, MAP_SHARED, fd)
        return Vcpu{ .fd = fd, .run_page = run, .run_size = @as(i64, size) }
    }
}

const GuestMemory = struct {
    base: *u8
    gpa: u64
    size: i64

    fn offset(self: GuestMemory, addr: u64, n: i64) i64 {
        if (addr < self.gpa or n < 0) {
            return -1
        }
        const rel = addr - self.gpa
        if (rel > @as(u64, self.size)) {
            return -1
        }
        const off = @as(i64, rel)
        if (off > self.size - n) {
            return -1
        }
        return off
    }

    // Copies bytes into guest memory at guest physical address addr.
    fn write(self: GuestMemory, addr: u64, bytes: []u8) !void {
        const off = self.offset(addr, @len(bytes))
        if (off < 0) {
            return error.OutOfGuestMemory
        }
        var i = 0
        while (i < @len(bytes)) {
            @ptrAdd(self.base, off + i).* = bytes[i]
            i = i + 1
        }
    }

    // n bytes (1 to 8), little-endian, at addr.
    fn read_le(self: GuestMemory, addr: u64, n: i64) !u64 {
        const off = self.offset(addr, n)
        if (off < 0 or n > 8) {
            return error.OutOfGuestMemory
        }
        var v: u64 = 0
        var i = n - 1
        while (i >= 0) {
            v = (v << 8) | @as(u64, @ptrAdd(self.base, off + i).*)
            i = i - 1
        }
        return v
    }

    fn write_le(self: GuestMemory, addr: u64, n: i64, v: u64) !void {
        const off = self.offset(addr, n)
        if (off < 0 or n > 8) {
            return error.OutOfGuestMemory
        }
        var x = v
        var i = 0
        while (i < n) {
            @ptrAdd(self.base, off + i).* = @as(u8, x & 0xff)
            x = x >> 8
            i = i + 1
        }
    }

    fn read_u8(self: GuestMemory, addr: u64) !u8 {
        const off = self.offset(addr, 1)
        if (off < 0) {
            return error.OutOfGuestMemory
        }
        return @ptrAdd(self.base, off).*
    }
}

// Why KVM_RUN returned, from the vCPU's kvm_run page.
const Exit = struct {
    reason: i64
    // KVM_EXIT_IO (port) and KVM_EXIT_MMIO (addr)
    write: bool
    size: i64
    port: i64
    count: i64
    addr: u64
    data: u64     // what the guest wrote, for an access of up to 8 bytes
    data_offset: i64
    // KVM_EXIT_FAIL_ENTRY, KVM_EXIT_INTERNAL_ERROR, KVM_EXIT_SYSTEM_EVENT
    detail: u64

    fn other(reason: i64, detail: u64) Exit {
        return Exit{ .reason = reason, .write = false, .size = 0, .port = 0, .count = 0, .addr = 0, .data = 0, .data_offset = 0, .detail = detail }
    }
}

const Vcpu = struct {
    fd: i32
    run_page: *u8
    run_size: i64

    fn get_regs(self: Vcpu, a: Allocator) !Buf(u8) {
        const b = a.alloc(REGS_SIZE, @as(u8, 0))
        errdefer a.free(b)
        _ = try ioctl_buf(self.fd, KVM_GET_REGS, b)
        return b
    }

    fn set_regs(self: Vcpu, regs: Buf(u8)) !void {
        _ = try ioctl_buf(self.fd, KVM_SET_REGS, regs)
    }

    fn get_sregs(self: Vcpu, a: Allocator) !Buf(u8) {
        const b = a.alloc(SREGS_SIZE, @as(u8, 0))
        errdefer a.free(b)
        _ = try ioctl_buf(self.fd, KVM_GET_SREGS, b)
        return b
    }

    fn set_sregs(self: Vcpu, sregs: Buf(u8)) !void {
        _ = try ioctl_buf(self.fd, KVM_SET_SREGS, sregs)
    }

    fn set_cpuid(self: Vcpu, cpuid: Buf(u8)) !void {
        _ = try ioctl_buf(self.fd, KVM_SET_CPUID2, cpuid)
    }

    // x87 control word and MXCSR at their reset values; KVM leaves them 0.
    fn init_fpu(self: Vcpu, a: Allocator) !void {
        var fpu = a.alloc(FPU_SIZE, @as(u8, 0))
        defer a.free(fpu)
        put_le(&fpu[0..], 128, 2, 0x37f)
        put_le(&fpu[0..], 408, 4, 0x1f80)
        _ = try ioctl_buf(self.fd, KVM_SET_FPU, fpu)
    }

    // LINT0 delivers the PIC's interrupts (ExtINT) and LINT1 NMIs, the
    // local APIC's virtual wire mode, as Firecracker sets it.
    fn init_lapic(self: Vcpu, a: Allocator) !void {
        var lapic = a.alloc(LAPIC_SIZE, @as(u8, 0))
        defer a.free(lapic)
        _ = try ioctl_buf(self.fd, KVM_GET_LAPIC, lapic)
        const lint0 = le(lapic[0..], 0x350, 4)
        const lint1 = le(lapic[0..], 0x360, 4)
        put_le(&lapic[0..], 0x350, 4, (lint0 & ~@as(u64, 0x700)) | 0x700)
        put_le(&lapic[0..], 0x360, 4, (lint1 & ~@as(u64, 0x700)) | 0x400)
        _ = try ioctl_buf(self.fd, KVM_SET_LAPIC, lapic)
    }

    fn run(self: Vcpu) !Exit {
        _ = try sys(ioctl(self.fd, KVM_RUN, 0))
        const r = @sliceFromPtr(self.run_page, self.run_size)
        // struct kvm_run: exit_reason at 8; the union of exit details at 32.
        const reason = @as(i64, le(r, 8, 4))
        if (reason == EXIT_IO) {
            // io: direction (1 = out), size, port, count, data_offset
            const size = @as(i64, le(r, 33, 1))
            const data_offset = @as(i64, le(r, 40, 8))
            var data: u64 = 0
            if (size <= 8 and data_offset >= 0 and data_offset <= self.run_size - size) {
                data = le(r, data_offset, size)
            }
            return Exit{
                .reason = reason,
                .write = le(r, 32, 1) == 1,
                .size = size,
                .port = @as(i64, le(r, 34, 2)),
                .count = @as(i64, le(r, 36, 4)),
                .addr = 0,
                .data = data,
                .data_offset = data_offset,
                .detail = 0,
            }
        }
        if (reason == EXIT_MMIO) {
            // mmio: phys_addr, data[8], len, is_write
            const len = @as(i64, le(r, 48, 4))
            var data: u64 = 0
            if (len <= 8) {
                data = le(r, 40, len)
            }
            return Exit{
                .reason = reason,
                .write = le(r, 52, 1) == 1,
                .size = len,
                .port = 0,
                .count = 1,
                .addr = le(r, 32, 8),
                .data = data,
                .data_offset = 40,
                .detail = 0,
            }
        }
        // fail_entry.hardware_entry_failure_reason, internal.suberror and
        // system_event.type all start the union.
        return Exit.other(reason, le(r, 32, 8))
    }

    // Element i of what an out wrote: a string instruction (rep outsb) makes
    // one exit for count elements of size bytes, one after another.
    fn out_value(self: Vcpu, exit: Exit, i: i64) !u64 {
        const n = exit.size * exit.count
        if (exit.size > 8 or i < 0 or i >= exit.count or exit.data_offset < 0 or n < 0 or exit.data_offset > self.run_size - n) {
            return error.BadExit
        }
        const r = @sliceFromPtr(self.run_page, self.run_size)
        return le(r, exit.data_offset + i * exit.size, exit.size)
    }

    // The value an in or an MMIO read gets: v in each of its count elements
    // of size bytes, where KVM looks for it when the vCPU runs again.
    fn complete_read(self: Vcpu, exit: Exit, v: u64) !void {
        const n = exit.size * exit.count
        if (exit.size > 8 or exit.data_offset < 0 or n < 0 or exit.data_offset > self.run_size - n) {
            return error.BadExit
        }
        var i = 0
        while (i < exit.count) {
            var x = v
            var j = 0
            while (j < exit.size) {
                @ptrAdd(self.run_page, exit.data_offset + i * exit.size + j).* = @as(u8, x & 0xff)
                x = x >> 8
                j = j + 1
            }
            i = i + 1
        }
    }
}
