// Boots a Linux vmlinux on one vCPU with its console on ttyS0:
//
//     firecracker VMLINUX [CMDLINE]
//
// The interrupt controllers and the PIT are KVM's; this handles the VM
// exits for the serial port and the i8042 reset that `reboot=k` uses.
uses io, args, fs, alloc, time
const kvm = @import("kvm.egg")
const boot = @import("boot.egg")
const serial = @import("serial.egg")

const MEM_SIZE = 512 * 1024 * 1024
const MAX_LINE = 4096
const DEFAULT_CMDLINE = "console=ttyS0 reboot=k panic=1 pci=off i8042.noaux i8042.nomux i8042.dumbkbd"

const I8042_COMMAND = 0x64
const I8042_RESET: u64 = 0xfe
const CMOS_DATA = 0x71

fn main(io: Io, args: Args, files: Fs, a: Allocator, clock: Clock) void {
    if (args.len() < 2) {
        io.eprint("usage: firecracker VMLINUX [CMDLINE]")
        return
    }
    var cmdline = DEFAULT_CMDLINE
    if (args.len() > 2) {
        cmdline = args.get(2)
    }
    run(io, files, a, clock, args.get(1), cmdline) catch |e| {
        io.eprint("firecracker: ", @errorName(e))
    }
}

fn run(io: Io, files: Fs, a: Allocator, clock: Clock, kernel: str, cmdline: str) !void {
    const start = clock.monotonic()
    const k = try kvm.Kvm.init(a)
    const vm = try k.create_vm()
    try vm.create_irqchip(a)
    const mem = try vm.add_memory(a, 0, 0, MEM_SIZE)

    const image = try kvm.read_file(a, kernel)
    defer a.free(image)
    const entry = try boot.load_elf(mem, image[0..])
    try boot.write_boot_data(mem, a, cmdline)

    const vcpu = try vm.create_vcpu(0)
    const cpuid = try k.supported_cpuid(a)
    defer a.free(cpuid)
    try vcpu.set_cpuid(cpuid)
    var sregs = try vcpu.get_sregs(a)
    defer a.free(sregs)
    boot.configure_sregs(&sregs[0..])
    try vcpu.set_sregs(sregs)
    var regs = a.alloc(kvm.REGS_SIZE, @as(u8, 0))
    defer a.free(regs)
    boot.configure_regs(&regs[0..], entry)
    try vcpu.set_regs(regs)
    try vcpu.init_fpu(a)
    try vcpu.init_lapic(a)
    io.eprint("[vmm] kernel ", kernel, ": ", @len(image), " bytes, entry ", entry, ", ", MEM_SIZE / 1024 / 1024, " MiB")
    io.eprint("[vmm] cmdline: ", cmdline)

    var uart = serial.Serial.init()
    var line = Buf(u8).empty
    defer a.free(line)
    var exits = 0
    while (true) {
        const exit = try vcpu.run()
        exits = exits + 1
        if (exit.reason == kvm.EXIT_IO and exit.write) {
            if (serial.Serial.owns(exit.port)) {
                var i = 0
                while (i < exit.count) {
                    const v = try vcpu.out_value(exit, i)
                    console(io, a, &line, uart.write(exit.port, @as(u8, v & 0xff)))
                    i = i + 1
                }
            } else if (exit.port == I8042_COMMAND and exit.data == I8042_RESET) {
                done(io, a, &line, clock, start, exits, "the guest reset the machine (i8042)")
                return
            }
        } else if (exit.reason == kvm.EXIT_IO) {
            var v: u64 = 0
            if (serial.Serial.owns(exit.port)) {
                v = @as(u64, uart.read(exit.port))
            } else if (exit.port != I8042_COMMAND and exit.port != CMOS_DATA) {
                // Nothing here: the bus floats high.
                v = 0xffffffff
            }
            try vcpu.complete_read(exit, v)
        } else if (exit.reason == kvm.EXIT_MMIO) {
            if (!exit.write) {
                try vcpu.complete_read(exit, 0)
            }
        } else if (exit.reason == kvm.EXIT_SYSTEM_EVENT) {
            done(io, a, &line, clock, start, exits, "the guest shut down or reset (system event)")
            return
        } else if (exit.reason == kvm.EXIT_SHUTDOWN) {
            done(io, a, &line, clock, start, exits, "triple fault")
            return error.TripleFault
        } else if (exit.reason == kvm.EXIT_HLT) {
            done(io, a, &line, clock, start, exits, "the vCPU halted")
            return
        } else {
            done(io, a, &line, clock, start, exits, "unexpected exit")
            io.eprint("[vmm] exit reason ", exit.reason, ", detail ", exit.detail)
            return error.UnexpectedExit
        }
    }
}

// A byte the guest sent to the serial port (-1 for none), printed a line at
// a time. A line is printed at MAX_LINE bytes even without a newline, so a
// guest cannot make the VMM hold its output without bound.
fn console(io: Io, a: Allocator, inout line: Buf(u8), c: i64) void {
    if (c == '\n' or (c >= 0 and @len(line) >= MAX_LINE)) {
        io.print(line)
        a.resize(&line, 0, 0)
    }
    if (c >= 0 and c != '\n' and c != '\r') {
        a.push(&line, @as(u8, c))
    }
}

fn done(io: Io, a: Allocator, inout line: Buf(u8), clock: Clock, start: i64, exits: i64, why: str) void {
    if (@len(line) > 0) {
        io.print(line)
        a.resize(&line, 0, 0)
    }
    const ms = (clock.monotonic() - start) / 1000000
    io.eprint("[vmm] ", why, " after ", ms, " ms and ", exits, " VM exits")
}
