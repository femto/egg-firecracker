// Boots a Linux vmlinux on one vCPU with its console on ttyS0:
//
//     firecracker VMLINUX [--initrd FILE] [--drive FILE] [CMDLINE]
//
// --drive attaches a disk image as a virtio block device, /dev/vda; with
// no CMDLINE, it is the root file system.
// The interrupt controllers and the PIT are KVM's; this handles the VM
// exits for the serial port and the i8042 reset that `reboot=k` uses.
// Standard input goes to the serial port; on a terminal, raw, with ^A x to
// stop.
uses io, args, fs, alloc, thread
const time = @import("std/time")
const kvm = @import("kvm.egg")
const boot = @import("boot.egg")
const serial = @import("serial.egg")
const console = @import("console.egg")
const input = @import("input.egg")
const virtio = @import("virtio.egg")
const acpi = @import("acpi.egg")

const MEM_SIZE = 512 * 1024 * 1024
const DEFAULT_CMDLINE = "console=ttyS0 reboot=k panic=1 pci=off i8042.noaux i8042.nomux i8042.dumbkbd"
const ROOT_CMDLINE = " root=/dev/vda rw"
const USAGE = "usage: firecracker VMLINUX [--initrd FILE] [--drive FILE] [CMDLINE]"

const I8042_COMMAND = 0x64
const I8042_RESET: u64 = 0xfe
const CMOS_DATA = 0x71

fn main(io: Io, args: Args, files: Fs, a: Allocator, threads: Threads) void {
    if (args.len() < 2) {
        io.eprint(USAGE)
        return
    }
    var initrd = ""
    var drive = ""
    var cmdline = ""
    var i = 2
    while (i < args.len()) {
        const arg = args.get(i)
        if (arg == "--initrd" or arg == "--drive") {
            if (i + 1 == args.len()) {
                io.eprint(USAGE)
                return
            }
            if (arg == "--initrd") {
                initrd = args.get(i + 1)
            } else {
                drive = args.get(i + 1)
            }
            i = i + 2
        } else {
            cmdline = arg
            i = i + 1
        }
    }
    var line = Buf(u8).empty
    if (@len(cmdline) > 0) {
        a.append_str(&line, cmdline)
    } else {
        a.append_str(&line, DEFAULT_CMDLINE)
        if (@len(drive) > 0) {
            a.append_str(&line, ROOT_CMDLINE)
        }
    }
    // Kept for the whole run, as the arguments are.
    const full = a.leak(line)
    a.free(line)
    run(io, files, a, threads, args.get(1), initrd, drive, full) catch |e| {
        io.eprint("firecracker: ", @errorName(e))
    }
}

fn run(io: Io, files: Fs, a: Allocator, threads: Threads, kernel: str, initrd: str, drive: str, cmdline: str) !void {
    const start = time.monotonic()
    const k = try kvm.Kvm.init(a)
    const vm = try k.create_vm()
    try vm.create_irqchip(a)
    const mem = try vm.add_memory(a, 0, 0, MEM_SIZE)

    const image = try kvm.read_file(a, kernel)
    defer a.free(image)
    const loaded = try boot.load_elf(mem, image[0..])
    var initrd_addr: u64 = 0
    var initrd_size: u64 = 0
    if (@len(initrd) > 0) {
        const ramdisk = try kvm.read_file(a, initrd)
        defer a.free(ramdisk)
        initrd_addr = try boot.load_initrd(mem, loaded, ramdisk[0..])
        initrd_size = @as(u64, @len(ramdisk))
        io.eprint("[vmm] initrd ", initrd, ": ", initrd_size, " bytes at ", initrd_addr)
    }
    try boot.write_boot_data(mem, a, cmdline, initrd_addr, initrd_size)
    // The ACPI tables, and the RSDP's address in the zero page's
    // acpi_rsdp_addr.
    const rsdp = try acpi.write_tables(mem, a, @len(drive) > 0)
    try mem.write_le(boot.ZERO_PAGE_START + 0x070, 8, rsdp)
    var blk = virtio.Blk.none()
    if (@len(drive) > 0) {
        blk = virtio.Blk.init(try kvm.Disk.open_path(a, drive))
        io.eprint("[vmm] drive ", drive, ": ", blk.disk.size, " bytes, /dev/vda")
    }
    defer blk.disk.close()
    var blk_line = false

    const vcpu = try vm.create_vcpu(0)
    const cpuid = try k.supported_cpuid(a)
    defer a.free(cpuid)
    try vcpu.set_cpuid(cpuid)
    var sregs = try vcpu.get_sregs(a)
    defer a.free(sregs)
    boot.configure_sregs(&sregs[0..])
    try vcpu.set_sregs(sregs)
    var regs = a.alloc(kvm.REGS_SIZE, @as(u8, 0))
    defer a.free(regs)
    boot.configure_regs(&regs[0..], loaded.entry)
    try vcpu.set_regs(regs)
    try vcpu.init_fpu(a)
    try vcpu.init_lapic(a)
    io.eprint("[vmm] kernel ", kernel, ": ", @len(image), " bytes, entry ", loaded.entry, ", ", MEM_SIZE / 1024 / 1024, " MiB")
    io.eprint("[vmm] cmdline: ", cmdline)

    // The input thread keeps its own copy of the terminal's settings, to
    // put back when ^A x ends the process under this thread.
    const saved = try kvm.raw_stdin(a)
    defer a.free(saved)
    defer kvm.restore_stdin(saved)
    const live = @len(saved) > 0
    const rx = threads.channel(u8, 4096)
    defer rx.close()
    threads.spawn(input.run, rx.sender(), io, a, vm, a.concat(saved, "")).detach()
    if (live) {
        io.eprint("[vmm] the console takes the keyboard: ^A x stops")
    }

    var uart = serial.Serial.init()
    var line = Buf(u8).empty
    defer a.free(line)
    var exits = 0
    while (true) {
        const exit = try vcpu.run()
        exits = exits + 1
        if (exit.reason == kvm.EXIT_IO and exit.write) {
            if (serial.Serial.owns(exit.port)) {
                try console.out(io, a, &uart, &line, vcpu, exit, live)
                if (uart.take_irq()) {
                    try vm.irq_pulse(a, serial.IRQ)
                }
            } else if (exit.port == I8042_COMMAND and exit.data == I8042_RESET) {
                done(io, a, &line, start, exits, "the guest reset the machine (i8042)")
                return
            }
        } else if (exit.reason == kvm.EXIT_IO) {
            var v: u64 = 0
            if (serial.Serial.owns(exit.port)) {
                if (uart.reads_rx(exit.port)) {
                    input.drain(rx, &uart)
                }
                v = @as(u64, uart.read(exit.port))
            } else if (exit.port != I8042_COMMAND and exit.port != CMOS_DATA) {
                // Nothing here: the bus floats high.
                v = 0xffffffff
            }
            try vcpu.complete_read(exit, v)
            if (uart.take_irq()) {
                try vm.irq_pulse(a, serial.IRQ)
            }
        } else if (exit.reason == kvm.EXIT_MMIO) {
            if (blk.owns(exit.addr)) {
                if (exit.write) {
                    blk.write(mem, exit.addr, exit.size, exit.data)
                } else {
                    try vcpu.complete_read(exit, blk.read(exit.addr, exit.size))
                }
                // The device's line is level-triggered: it follows the
                // interrupt status, raised by a completion, lowered by
                // the driver's acknowledgement or a reset.
                if (blk.line() != blk_line) {
                    blk_line = blk.line()
                    var level: u64 = 0
                    if (blk_line) {
                        level = 1
                    }
                    try vm.irq_line(a, virtio.IRQ, level)
                }
            } else if (!exit.write) {
                try vcpu.complete_read(exit, 0)
            }
        } else if (exit.reason == kvm.EXIT_SYSTEM_EVENT) {
            done(io, a, &line, start, exits, "the guest shut down or reset (system event)")
            return
        } else if (exit.reason == kvm.EXIT_SHUTDOWN) {
            done(io, a, &line, start, exits, "triple fault")
            return error.TripleFault
        } else if (exit.reason == kvm.EXIT_HLT) {
            done(io, a, &line, start, exits, "the vCPU halted")
            return
        } else {
            done(io, a, &line, start, exits, "unexpected exit")
            io.eprint("[vmm] exit reason ", exit.reason, ", detail ", exit.detail)
            return error.UnexpectedExit
        }
    }
}

fn done(io: Io, a: Allocator, inout line: Buf(u8), start: i64, exits: i64, why: str) void {
    console.flush(io, a, &line)
    const ms = (time.monotonic() - start) / 1000000
    io.eprint("[vmm] ", why, " after ", ms, " ms and ", exits, " VM exits")
}
