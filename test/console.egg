// The console's handling of serial outs, through the code the VMM runs,
// on exits made here: a kvm_run page in a buffer, with the bytes of a
// string out at data_offset. Needs no KVM.
uses io, alloc
allow unsafe
const kvm = @import("firecracker/kvm")
const serial = @import("firecracker/serial")
const console = @import("firecracker/console")

const PAGE = 8192
const DATA = 4096

fn out_exit(count: i64) kvm.Exit {
    return kvm.Exit{ .reason = kvm.EXIT_IO, .write = true, .size = 1, .port = 0x3f8, .count = count, .addr = 0, .data = 0, .data_offset = DATA, .detail = 0 }
}

fn main(io: Io, a: Allocator) !void {
    var page = a.alloc(PAGE, @as(u8, 0))
    defer a.free(page)
    var uart = serial.Serial.init()
    var line = Buf(u8).empty
    defer a.free(line)

    // One exit carrying "AB\n" (rep outsb of 3 bytes): all three count.
    page[DATA] = 'A'
    page[DATA + 1] = 'B'
    page[DATA + 2] = '\n'
    const vcpu = kvm.Vcpu{ .fd = -1, .run_page = @bufPtr(page), .run_size = PAGE }
    try console.out(io, a, &uart, &line, vcpu, out_exit(3))

    // 4000 bytes in one exit and 100 in another, no newline: the line is
    // printed at 4096 bytes, and 4 are kept.
    var i = 0
    while (i < 4000) {
        @ptrAdd(@bufPtr(page), DATA + i).* = 'x'
        i = i + 1
    }
    try console.out(io, a, &uart, &line, vcpu, out_exit(4000))
    io.print("kept ", @len(line))
    try console.out(io, a, &uart, &line, vcpu, out_exit(100))
    io.print("kept ", @len(line))

    // An exit claiming more elements than kvm_run holds is refused.
    console.out(io, a, &uart, &line, vcpu, out_exit(PAGE)) catch |e| {
        io.print("refused: ", @errorName(e))
    }
}
